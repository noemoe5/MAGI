{
  "name": "magi",
  "version": "2.2.0",
  "description": "MAGI - local media hub: novel reader + foobar-style music library + libVLC video player, built on Electron + React",
  "main": "electron/main.cjs",
  "author": "noemoe5",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/noemoe5/MAGI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noemoe5/MAGI.git"
  },
  "bugs": {
    "url": "https://github.com/noemoe5/MAGI/issues"
  },
  "keywords": [
    "electron",
    "epub-reader",
    "music-player",
    "video-player",
    "libvlc",
    "vlc",
    "flac",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "smoke": "node scripts/smoke.mjs 9333",
    "probe:video": "node scripts/probe-video.mjs 9333",
    "probe:music": "node scripts/probe-music.mjs 9333",
    "probe:reader": "node scripts/probe-reader.mjs 9333",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "framer-motion": "^13.5.1",
    "koffi": "^3.3.4",
    "music-metadata": "^12.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unzipper": "^0.12.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.noemoe5.magi",
    "productName": "MAGI",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/vlc",
        "to": "vlc",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "languages",
        "to": "languages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../magi_out"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MAGI"
    },
    "portable": {
      "artifactName": "MAGI-portable-${version}.exe"
    }
  }
}
