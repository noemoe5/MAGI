{
  "name": "novel-reader",
  "version": "1.0.0",
  "description": "Koodo-style novel reader (Electron + React + EPUB.js)",
  "main": "electron/main.cjs",
  "author": "noemoe5",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "framer-motion": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.noemoe5.novelreader",
    "productName": "NovelReader",
    "files": ["dist/**/*", "electron/**/*", "package.json", "!node_modules/**/*"],
    "directories": { "output": "../nr_out" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NovelReader"
    },
    "portable": { "artifactName": "NovelReader-portable-${version}.exe" }
  }
}
